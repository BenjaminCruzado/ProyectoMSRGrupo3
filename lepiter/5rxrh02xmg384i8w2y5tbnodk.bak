				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Calculamos un porcentaje que indica qué proporción de conversaciones contienen fragmentos de código, entregando el número de forma navegable para posibles usos o despliegues gráficos."
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
