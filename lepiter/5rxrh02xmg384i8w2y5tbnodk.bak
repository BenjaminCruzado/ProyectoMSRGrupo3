				"code" : "\"Ordenar el diccionario por tamaño de listas (cantidad de conversaciones) de mayor a menor\"\r\nsorted := dictLenguajesConvs\r\n    associations\r\n    sorted: [:a :b | (a value size) > (b value size)].\r\n\r\n\"Tomar los primeros 5 elementos\"\r\ntop5 := sorted first: (sorted size min: 5).\r\n\r\n\"Crear nuevo diccionario con los top 5 lenguajes y sus conversaciones\"\r\ntop5Dict := Dictionary new.\r\ntop5 do: [:assoc |\r\n    top5Dict at: assoc key put: assoc value.\r\n].\r\n\r\n\"Mostrar resultado para navegación\"\r\ntop5Dict"
