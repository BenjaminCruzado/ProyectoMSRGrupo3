				"uid" : {
					"__type" : "uid",
					"uidString" : "uHGcujv+DQCbjHT4CoCQYQ=="
				},
				"code" : "| porcentaje totalConversaciones totalConversacionesCodigo |\r\n\r\ntotalConversaciones := allConversations size.\r\ntotalConversacionesCodigo := conversationsWithCode size.\r\n\r\nporcentaje := 0.\r\ntotalConversaciones > 0 ifTrue: [\r\n    porcentaje := (totalConversacionesCodigo asFloat / totalConversaciones) * 100.\r\n].\r\n\r\n\"Retornamos el valor para visualización\"\r\nporcentaje"
			},
