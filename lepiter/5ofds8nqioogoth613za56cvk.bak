				"code" : "dictCategorias := Dictionary new.\r\ndictCategorias at: 'Debugging and Bugs' put: #('bug' 'error' 'exception' 'crash' 'fail' 'fix' 'issue' 'fault' 'defect' 'debug' 'panic' 'traceback' 'stack trace' 'problem' 'breakpoint').\r\ndictCategorias at: 'Syntax Errors' put: #('syntax error' 'compile error' 'parse error' 'invalid syntax' 'typo' 'missing semicolon' 'unexpected token' 'parse failure').\r\ndictCategorias at: 'Refactoring and Optimization' put: #('refactor' 'optimize' 'performance' 'clean code' 'improve efficiency' 'reduce complexity' 'best practice' 'memory usage' 'speed up').\r\ndictCategorias at: 'Testing' put: #('test' 'unit test' 'integration test' 'mock' 'assertion' 'test case' 'coverage' 'test suite' 'regression' 'validation').\r\ndictCategorias at: 'Explanation and Documentation' put: #('explain' 'document' 'comment' 'tutorial' 'guide' 'instruction' 'help' 'manual' 'description' 'note' 'example' 'readme' 'javadoc' 'uml').\r\ndictCategorias at: 'Design and Implementation' put: #('design' 'architecture' 'pattern' 'implement' 'feature' 'module' 'component' 'framework' 'interface' 'workflow' 'pipeline' 'mvc' 'singleton' 'microservices').\r\ndictCategorias at: 'Code Review' put: #('review' 'suggest' 'improve' 'best practice' 'code style' 'refinement' 'feedback' 'analysis' 'critique').\r\ndictCategorias at: 'Error Handling' put: #('error handling' 'exception handling' 'try catch' 'failover' 'rollback' 'transaction management').\r\ndictCategorias at: 'Security' put: #('secure' 'vulnerability' 'attack' 'threat' 'protection' 'authentication' 'authorization' 'safety' 'encryption' 'csrf' 'xss' 'sql injection').\r\ndictCategorias at: 'Dependencies and Tools' put: #('dependency' 'version conflict' 'build error' 'library' 'tool' 'package' 'plugin' 'integration' 'environment' 'configuration' 'docker' 'maven' 'gradle').\r\ndictCategorias at: 'Performance and Scalability' put: #('bottleneck' 'slow' 'scale' 'memory leak' 'throughput' 'latency' 'resource' 'load balancing' 'parallel' 'concurrency' 'threading' 'caching').\r\ndictCategorias at: 'Education and Training' put: #('training plan' 'lesson plan' 'teaching' 'learning' 'curriculum' 'educational' 'student' 'skill building' 'tutorial' 'guide' 'objectives' 'workshop' 'class' 'coding bootcamp').\r\ndictCategorias at: 'General Technical Queries' put: #('information' 'explain' 'description' 'author' 'story' 'data' 'conclusion' 'analysis' 'estimate' 'calculation' 'note' 'advice' 'question' 'query').\r\ndictCategorias at: 'Other Technical Topics' put: #('api' 'rest' 'graphql' 'http' 'https' 'json' 'xml' 'serialization' 'deserialization' 'tcp' 'udp' 'network' 'protocol' 'cloud' 'aws' 'azure' 'gcp')."
