					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-21T10:01:28.143-03:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-23T21:53:38.667-03:00"
