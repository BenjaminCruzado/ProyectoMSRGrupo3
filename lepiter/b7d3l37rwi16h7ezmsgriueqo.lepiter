				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Para cada conversación se evalúa la presencia de palabras clave para asignar la categoría más representativa, acumulando las conversaciones en un diccionario navegable por categoría."
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
