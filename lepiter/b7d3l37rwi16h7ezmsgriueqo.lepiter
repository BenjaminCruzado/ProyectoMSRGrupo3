				"code" : "\"Ordenar categorías por tamaño de colecciones, excluyendo 'Sin categoría'\"\r\nsortedCats := (dictCategoriasConvs associations\r\n    reject: [:assoc | assoc key = 'Sin categoría'])\r\n    sorted: [:a :b | (a value size) > (b value size)].\r\n\r\n\"Tomar los primeros 5\"\r\ntop5Cats := sortedCats first: (sortedCats size min: 5).\r\n\r\n\"Crear un diccionario con las top 5 categorías\"\r\ntop5Dict := Dictionary new.\r\ntop5Cats do: [:assoc |\r\n    top5Dict at: assoc key put: assoc value.\r\n].\r\n\r\n\"Retornar diccionario navegable con top 5 categorías y sus conversaciones\"\r\ntop5Dict\r\n"
