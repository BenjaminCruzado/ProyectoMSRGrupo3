				"uid" : {
					"__type" : "uid",
					"uidString" : "SJ+mmj7+DQCa+GzkAT8tyw=="
				},
				"code" : "sources do: [:source |\r\n  (source isKindOf: Dictionary) ifTrue: [\r\n    (source at: 'ChatgptSharing' ifAbsent: [#()]) do: [:chatgptSharing |\r\n      | date dateHour franja |\r\n      date := (chatgptSharing at: 'DateOfAccess' ifAbsent: ['']) asString.\r\n      (date isEmpty) ifFalse: [\r\n        date := DateAndTime fromString: date.\r\n        dateHour := date hour.\r\n        franja := (dateHour >= 6 and: [dateHour <= 12]) ifTrue: ['Mañana']\r\n                  ifFalse: [(dateHour >= 13 and: [dateHour <= 18]) ifTrue: ['Tarde'] ifFalse: ['Noche']].\r\n        (franjaConversations at: franja) add: chatgptSharing.\r\n      ].\r\n    ].\t\r\n  ].\r\n].\r\rfranjaConversations keysAndValuesDo: [:franja :convs |\r\n  Transcript show: franja , ' (' , convs size printString , ' conversaciones). Haga clic para desplegar:'; cr.\r\n  convs do: [:conv |\r\n    Transcript show: '   - Conversation ID: ' , (conv at: 'Id' ifAbsent: ['sin id']) asString; cr.\r\n  ].\r\n].\t"
			}
		]
