				"code" : "porcentaje := 0.\r\ncontadorConversaciones > 0 ifTrue: [\r\n    porcentaje := (contadorCodigos asFloat / contadorConversaciones) * 100.\r\n].\r\n\r\nTranscript show: 'Porcentaje aproximado de fragmentos de código por conversación: ', (porcentaje printShowingDecimalPlaces: 2), '%'; cr."
			},
