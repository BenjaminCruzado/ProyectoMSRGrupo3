					"uidString" : "6HpZYDv+DQC3O54ZCKTYBg=="
				},
				"code" : "\"Leer archivo JSON y parsear\"\r\njson := '1.json' asFileReference readStream contents.\r\ndictionary := STONJSON fromString: json.\t\t\t\r\nsources := dictionary at: 'Sources' ifAbsent: [#()].\r\n\r\n\"Diccionario de lenguaje -> conversaciones\"\r\ndictLenguajesConvs := Dictionary new.\r\n\r\nsources do: [:source |\r\n    chatgptSharings := (source isKindOf: Dictionary)\r\n        ifTrue: [source at: 'ChatgptSharing' ifAbsent: [#()]]\r\n        ifFalse: [#()].\r\n\r\n    (chatgptSharings isKindOf: Array) ifTrue: [\r\n        chatgptSharings do: [:chatgptSharing |\r\n            conversations := (chatgptSharing isKindOf: Dictionary)\r\n                ifTrue: [chatgptSharing at: 'Conversations' ifAbsent: [#()]]\r\n                ifFalse: [#()].\r\n\r\n            (conversations isKindOf: Array) ifTrue: [\r\n                conversations do: [:conv |\r\n                    listOfCode := (conv isKindOf: Dictionary)\r\n                        ifTrue: [conv at: 'ListOfCode' ifAbsent: [#()]]\r\n                        ifFalse: [#()].\r\n\r\n                    \"Procesar cada fragmento de código para detectar lenguajes y agrupar conversaciones\"\r\n                    listOfCode do: [:codeItem |\r\n                        (codeItem isKindOf: Dictionary) ifTrue: [\r\n                            content := codeItem at: 'Content' ifAbsent: [nil].\r\n                            content ifNotNil: [\r\n                                | rawType typeCode |\r\n\r\n                                rawType := codeItem at: 'Type' ifAbsent: [nil].\r\n                                typeCode := nil.\r\n                                rawType ifNotNil: [\r\n                                    typeCode := (rawType isKindOf: Array) \r\n                                        ifTrue: [rawType first] \r\n                                        ifFalse: [rawType].\r\n                                ].\r\n                                typeCode ifNil: [typeCode := 'desconocido'].\r\n\r\n                                \"Si el lenguaje no está en el diccionario, inicializar con colección vacía\"\r\n                                dictLenguajesConvs at: typeCode\r\n                                    ifAbsentPut: [OrderedCollection new].\r\n\r\n                                \"Agregar la conversación si no está ya incluida para evitar duplicados\"\r\n                                (dictLenguajesConvs at: typeCode)\r\n                                    ifNone: [OrderedCollection new].\r\n                                (dictLenguajesConvs at: typeCode)\r\n                                    includes: conv\r\n                                    ifFalse: [dictLenguajesConvs at: typeCode add: conv].\r\n                            ].\r\n                        ].\r\n                    ].\r\n                ].\r\n            ].\r\n        ].\r\n    ].\r\n].\r\n\r\n\"Devolver el diccionario para navegación\"\r\ndictLenguajesConvs\r\n"
			}
		]
	},
