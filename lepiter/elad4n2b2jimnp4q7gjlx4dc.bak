					"uidString" : "0LB8PTv+DQC3L/FDCKTYBg=="
				},
				"code" : "\"Leer archivo JSON y parsear\"\r\njson := '1.json' asFileReference readStream contents.\r\ndictionary := STONJSON fromString: json.\t\t\t\r\nsources := dictionary at: 'Sources' ifAbsent: [#()].\r\n\r\n\"Recolectar conversaciones que contienen códigos\"\r\nconversationsWithCode := OrderedCollection new.\r\n\r\nsources do: [:source |\r\n    chatgptSharings := (source isKindOf: Dictionary)\r\n        ifTrue: [source at: 'ChatgptSharing' ifAbsent: [#()]]\r\n        ifFalse: [#()].\r\n\r\n    (chatgptSharings isKindOf: Array) ifTrue: [\r\n        chatgptSharings do: [:chatgptSharing |\r\n            conversations := (chatgptSharing isKindOf: Dictionary)\r\n                ifTrue: [chatgptSharing at: 'Conversations' ifAbsent: [#()]]\r\n                ifFalse: [#()].\r\n\r\n            (conversations isKindOf: Array) ifTrue: [\r\n                conversations do: [:conv |\r\n                    listOfCode := (conv isKindOf: Dictionary)\r\n                        ifTrue: [conv at: 'ListOfCode' ifAbsent: [#()]]\r\n                        ifFalse: [#()].\r\n\r\n                    \"Filtrar solo si tiene al menos un código con contenido\"\r\n                    (listOfCode detect: [:codeItem |\r\n                        (codeItem isKindOf: Dictionary) and: [\r\n                            (codeItem at: 'Content' ifAbsent: [nil]) notNil\r\n                        ]\r\n                    ] ifNone: [nil]) \r\n                    ifNotNil: [\r\n                        conversationsWithCode add: conv.\r\n                    ].\r\n                ].\r\n            ].\r\n        ].\r\n    ].\r\n].\r\n\r\n\"Resultado: lista de conversaciones que contienen código\"\r\nconversationsWithCode\r\n"
			},
			{
				"__type" : "pharoSnippet",
