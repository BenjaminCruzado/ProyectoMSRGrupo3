'environment' 'configuration').\r\ndictCategorias at: 'Performance & Scalability' put: #('bottleneck' 'slow' 'scale' 'memory leak' 'throughput' 'latency' 'resource' 'load balancing' 'parallel' 'concurrency').\r\ndictCategorias at: 'Education and Training' put: #('training plan' 'lesson plan' 'teaching' 'learning' 'curriculum' 'educational' 'student' 'skill building' 'tutorial' 'guide' 'objectives' 'workshop' 'class').\r\ndictCategorias at: 'General Non-Technical Queries' put: #('information' 'explain' 'description' 'author' 'name' 'story' 'data' 'conclusion' 'analysis' 'estimate' 'calculation' 'note' 'advice' 'plan' 'compassionate' 'question' 'query').\r\n\r\n\"Paso 3: Inicializar resultado para categorías\"\r\nresultado := Dictionary new.\r\ndictCategorias keys do: [:cat | resultado at: cat put: 0].\r\nresultado at: 'Sin categoría' put: 0.\r\n\r\n\"Paso 4: Recopilar prompts y asignar categorías\"\r\nsinCategoriaPrompts := OrderedCollection new.\r\n\r\nsources do: [:source |\r\n    chatgptSharings := (source isKindOf: Dictionary)\r\n        ifTrue: [source at: 'ChatgptSharing' ifAbsent: [#()]]\r\n        ifFalse: [#()].\r\n\r\n    chatgptSharings do: [:chatgptSharing |\r\n        conversations := (chatgptSharing isKindOf: Dictionary)\r\n            ifTrue: [chatgptSharing at: 'Conversations' ifAbsent: [#()]]\r\n            ifFalse: [#()].\r\n\r\n        conversations do: [:conv |\r\n            promptText := (conv isKindOf: Dictionary) & (conv includesKey: 'Prompt')\r\n                ifTrue: [(conv at: 'Prompt') asLowercase]\r\n                ifFalse: [''].\r\n\r\n            maxCount := 0.\r\n            maxCategory := ''.\r\n\r\n            dictCategorias keysAndValuesDo: [:cat :palabras |\r\n                | count |\r\n                count := 0.\r\n                palabras do: [:palabra |\r\n                    (promptText includesSubstring: palabra)\r\n                        ifTrue: [count := count + 1].\r\n                ].\r\n                count > maxCount ifTrue: [\r\n                    maxCount := count.\r\n                    maxCategory := cat.\r\n                ].\r\n            ].\r\n\r\n            (maxCategory isEmpty or: [maxCount = 0])\r\n                ifTrue: [\r\n                    resultado at: 'Sin categoría' put: ((resultado at: 'Sin categoría') + 1).\r\n                    sinCategoriaPrompts add: promptText.\r\n                ]\r\n                ifFalse: [\r\n                    resultado at: maxCategory put: ((resultado at: maxCategory) + 1)\r\n                ].\r\n        ].\r\n    ].\r\n].\r\n\r\n\"Paso 5: Lista de stopwords en inglés\"\r\nstopWords := #('the' 'and' 'for' 'that' 'with' 'you' 'this' 'have' 'but' 'not' 'are' 'from' 'was' 'all' 'they' 'his' 'her' 'she' 'him' 'has' 'had' 'will' 'would' 'there' 'their' 'what' 'when' 'which' 'your' 'can' 'were' 'one' 'about' 'who' 'get' 'like' 'just' 'out' 'some' 'them' 'then' 'now' 'how' 'our' 'more' 'also' 'could' 'into' 'than' 'other' 'because' 'these' 'over' 'after' 'first' 'may' 'any' 'time' 'only' 'new' 'very' 'even' 'most' 'make' 'such' 'well' 'way' 'many' 'should' 'very').\r\n\r\n\"Paso 6: Contar palabras frecuentes en prompts sin categoría\"\r\npalabrasFrecuentes := Dictionary new.\r\n\r\nsinCategoriaPrompts do: [:prompt |\r\n    | palabras |\r\n    palabras := prompt substrings: ' '.\r\n    palabras do: [:eachPalabra |\r\n        | palabraMinuscula |\r\n        palabraMinuscula := eachPalabra asLowercase.\r\n        (palabraMinuscula size > 2 and: [(stopWords includes: palabraMinuscula)not]) ifTrue: [\r\n            palabrasFrecuentes at: palabraMinuscula ifAbsentPut: [0].\r\n            palabrasFrecuentes at: palabraMinuscula put: ((palabrasFrecuentes at: palabraMinuscula) + 1).\r\n        ].\r\n    ].\r\n].\r\n\r\n\"Paso 7: Mostrar palabras frecuentes\"\r\nTranscript show: 'Palabras frecuentes en prompts sin categoria:'; cr.\r\npalabrasFrecuentes keysAndValuesDo: [:palabra :frecuencia |\r\n    Transcript show: palabra, ': ', frecuencia printString; cr.\r\n].\r\n"
