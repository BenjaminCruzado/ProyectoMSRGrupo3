eysAndValuesDo: [:cat :palabras |\r\n                | count |\r\n                count := 0.\r\n                palabras do: [:palabra |\r\n                    (promptText includesSubstring: palabra) ifTrue: [count := count + 1].\r\n                ].\r\n                count > maxCount ifTrue: [\r\n                    maxCount := count.\r\n                    maxCategory := cat.\r\n                ].\r\n            ].\r\n            (maxCategory isEmpty or: [maxCount = 0])\r\n                ifTrue: [resultado at: 'Sin categoría' put: ((resultado at: 'Sin categoría') + 1)]\r\n                ifFalse: [resultado at: maxCategory put: ((resultado at: maxCategory) + 1)].\r\n        ].\r\n    ].\r\n].\r\n\r\n\"Paso 5: Mostrar frecuencia absoluta\"\r\nTranscript show: 'Distribución final por categoría:'; cr.\r\nresultado keysAndValuesDo: [:cat :count |\r\n    Transcript show: cat , ': ' , count printString; cr.\r\n].\r\n\r\n\"Paso 6: Calcular y mostrar porcentaje (excluyendo 'Sin categoría')\"\r\ntotalRelevant := 0.\r\nresultado keysAndValuesDo: [:cat :count |\r\n    (cat ~= 'Sin categoría') ifTrue: [totalRelevant := totalRelevant + count].\r\n].\r\nTranscript show: 'Distribución porcentual por categoría (excluye Sin categoría):'; cr.\r\nresultado keysAndValuesDo: [:cat :count |\r\n    (cat ~= 'Sin categoría') ifTrue: [\r\n        | percentage |\r\n        percentage := (count / totalRelevant) * 100.\r\n        Transcript show: cat , ': ' , percentage printString , '%'; cr.\r\n    ].\r\n].\r\n"
			},
