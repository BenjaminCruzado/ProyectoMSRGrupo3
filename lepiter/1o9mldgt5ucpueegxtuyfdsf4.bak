l' 'student' 'skill building' 'tutorial' 'guide' 'objectives').\r\ndictCategorias at: 'General Non-Technical Queries' put: #('information' 'explain' 'description' 'author' 'name' 'story' 'data' 'conclusion' 'analysis' 'estimate' 'calculation' 'note' 'advice' 'plan' 'compassionate').\r\n\r\n\"Paso 3: Inicializar resultado en 0 para todas las categorías\"\r\nresultado := Dictionary new.\r\ndictCategorias keysDo: [:cat | resultado at: cat put: 0].\r\n\r\n\"Paso 4: Buscar palabras clave en prompt y hallar la categoría con más coincidencias\"\r\nmaxCount := 0.\r\nmaxCategory := ''.\r\n\r\ndictCategorias keysAndValuesDo: [:cat :palabras |\r\n    | count |\r\n    count := 0.\r\n    palabras do: [:palabra |\r\n        (promptText includesSubstring: palabra)\r\n            ifTrue: [count := count + 1].\r\n    ].\r\n\r\n    count > maxCount ifTrue: [\r\n        maxCount := count.\r\n        maxCategory := cat.\r\n    ].\r\n].\r\n\r\n\"Paso 5: Aumentar en 1 el contador para la categoría con más coincidencias\"\r\nmaxCategory isEmpty ifFalse: [\r\n    resultado at: maxCategory put: ((resultado at: maxCategory) + 1)\r\n].\r\n\r\n\"Paso 6: Mostrar resultados\"\r\nresultado keysAndValuesDo: [:cat :count |\r\n    Transcript\r\n        show: cat , ': ' , count printString;\r\n        cr.\r\n].\r\n"
