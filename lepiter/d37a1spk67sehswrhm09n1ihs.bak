				"code" : "json := '1.json' asFileReference readStream contents.\r\ndictionary := STONJSON fromString: json.\r\n\r\nsources := dictionary at: 'Sources' ifAbsent: [#()].\r\nquintoSource := sources at: 5.\r\n\r\nchatgptSharing := (quintoSource isKindOf: Dictionary)\r\n\tifTrue: [quintoSource at: 'ChatgptSharing' ifAbsent: [#()]]\r\n\tifFalse: [#()].\r\n\r\nisArrayNotEmpty := (chatgptSharing isKindOf: Array) and: [chatgptSharing notEmpty].\r\n\r\ncontador := 0.\r\n\r\nisArrayNotEmpty\r\n\tifTrue: [\r\n\t\tprimerElemento := chatgptSharing first.\r\n\r\n\t\tconversations := (primerElemento isKindOf: Dictionary)\r\n\t\t\tifTrue: [primerElemento at: 'Conversations' ifAbsent: [#()]]\r\n\t\t\tifFalse: [#()].\r\n\r\n\t\tconversations do: [:conv |\r\n\t\t\tlistOfCode := (conv isKindOf: Dictionary)\r\n\t\t\t\tifTrue: [conv at: 'ListOfCode' ifAbsent: [#()]]\r\n\t\t\t\tifFalse: [#()].\r\n\r\n\t\t\tlistOfCode do: [:codeItem |\r\n\t\t\t\t(content := (codeItem isKindOf: Dictionary)\r\n\t\t\t\t\tifTrue: [codeItem at: 'Content' ifAbsent: [nil]]\r\n\t\t\t\t\tifFalse: [nil]).\t\r\n\t\t\t\tcontent ifNotNil: [contador := contador + 1].\r\n\t\t\t].\r\n\t\t].\r\n\t\tTranscript show: 'Cantidad de fragmentos con Content: ', contador printString; cr.\r\n\t]\t\r\n\tifFalse: [\r\n\t\tTranscript show: 'ChatgptSharing no es arreglo o está vacío'; cr.\r\n\t].\r\n"
			},
