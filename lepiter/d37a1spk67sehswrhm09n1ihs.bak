				"code" : "\t\t\"Leer el archivo JSON y convertirlo a un diccionario\"\r\njson := '1.json' asFileReference readStream contents.\r\ndictionary := STONJSON fromString: json.\r\n\r\n\"Obtener la lista de Sources\"\r\nsources := dictionary at: 'Sources' ifAbsent: [#()].\r\n\r\n\"Tomar el quinto elemento de Sources\"\r\nquintoSource := sources at: 5.\r\n\r\n\"Obtener ChatgptSharing del quinto source, si existe\"\r\nchatgptSharing := (quintoSource isKindOf: Dictionary)\r\n    ifTrue: [quintoSource at: 'ChatgptSharing' ifAbsent: [#()]]\r\n    ifFalse: [#()].\r\n\r\n\"Verificar si chatgptSharing es un arreglo no vacío\"\r\nisArrayNotEmpty := (chatgptSharing isKindOf: Array) and: [chatgptSharing notEmpty].\r\n\r\n\"Mostrar el título del primer elemento si existe\"\r\nisArrayNotEmpty\r\n    ifTrue: [\r\n        primerElemento := chatgptSharing first.\r\n        title := (primerElemento isKindOf: Dictionary)\r\n            ifTrue: [primerElemento at: 'Title' ifAbsent: ['<sin título>']]\r\n            ifFalse: ['<elemento no es diccionario>'].\r\n        Transcript show: 'Title del primer elemento en ChatgptSharing: ', title; cr.\r\n    ]\r\n    ifFalse: [\r\n        Transcript show: 'ChatgptSharing no es arreglo o está vacío'; cr.\r\n    ].\r\n"
			},
