				"code" : "| sorted top4 rest restTotal total top5 otrosDict porcentaje |\r\n\r\n\"Ordenar asociaciones de mayor a menor\"\r\nsorted := (dictLenguajes associations\r\n            sorted: [:a :b | a value > b value]).\r\n\r\n\"Tomar los primeros 4\"\r\ntop4 := sorted first: 4.\r\n\r\n\"Sumar el resto\"\r\nrest := sorted allButFirst: 4.\r\nrestTotal := rest inject: 0 into: [:sum :assoc | sum + assoc value].\r\n\r\n\"Calcular el total general\"\r\ntotal := (top4 inject: restTotal into: [:sum :assoc | sum + assoc value]) asFloat.\r\n\r\n\"Crear diccionario para 'Otros'\"\r\notrosDict := Dictionary new.\r\notrosDict at: 'Otros' put: restTotal.\r\n\r\n\"Crear arreglo final con los 5 elementos\"\r\ntop5 := top4 copy , otrosDict associations.\r\n\r\n\"Mostrar cada elemento con su porcentaje en decimal\"\r\ntop5 do: [:assoc |\r\n    porcentaje := (assoc value asFloat / total * 100) roundTo: 0.01. \"2 decimales\"\r\n    Transcript\r\n        show: assoc key , ': ' , assoc value printString , ' (' , porcentaje printString , '%)';\r\n        cr.\r\n].\r\n"
