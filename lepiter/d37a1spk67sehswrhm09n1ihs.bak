				"code" : "json := '1.json' asFileReference readStream contents.\r\ndictionary := STONJSON fromString: json.\r\n\r\nsources := dictionary at: 'Sources' ifAbsent: [#()].\r\n\r\ncontadorConversaciones := 0.\r\ncontadorCodigos := 0.\r\n\r\nsources do: [:source |\r\n    chatgptSharings := (source isKindOf: Dictionary)\r\n        ifTrue: [source at: 'ChatgptSharing' ifAbsent: [#()]]\r\n        ifFalse: [#()].\r\n\r\n    (chatgptSharings isKindOf: Array) ifTrue: [\r\n        chatgptSharings do: [:chatgptSharing |\r\n            conversations := (chatgptSharing isKindOf: Dictionary)\r\n                ifTrue: [chatgptSharing at: 'Conversations' ifAbsent: [#()]]\r\n                ifFalse: [#()].\r\n\r\n            (conversations isKindOf: Array) ifTrue: [\r\n                contadorConversaciones := contadorConversaciones + conversations size.\r\n                conversations do: [:conv |\r\n                    listOfCode := (conv isKindOf: Dictionary)\r\n                        ifTrue: [conv at: 'ListOfCode' ifAbsent: [#()]]\r\n                        ifFalse: [#()].\r\n\r\n                    listOfCode do: [:codeItem |\r\n                        (codeItem isKindOf: Dictionary)\r\n                            ifTrue: [\r\n                                (codeItem at: 'Content' ifAbsent: [nil]) ifNotNil: [\r\n                                    contadorCodigos := contadorCodigos + 1\r\n                                ].\r\n                            ].\r\n                    ].\r\n                ].\r\n            ].\r\n        ].\r\n    ].\r\n].\r\n\r\nTranscript show: 'Cantidad total de conversaciones: ', contadorConversaciones printString; cr.\r\nTranscript show: 'Cantidad total de fragmentos con código: ', contadorCodigos printString; cr.\r\n\t\t"
