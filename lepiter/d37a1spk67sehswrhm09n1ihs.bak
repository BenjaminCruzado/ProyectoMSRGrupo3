				"code" : "\tporcentaje := 0.\r\t\n\tcontadorConversaciones > 0 ifTrue: [\r\t\n\t    porcentaje := (contadorCodigos asFloat / contadorConversaciones) * 100.\r\t\n\t].\r\t\n\t\t\r\t\n\tTranscript show: 'Porcentaje aproximado de fragmentos de código por conversación: ', (porcentaje printShowingDecimalPlaces: 2), '%'; cr.\r\t\n\t"
